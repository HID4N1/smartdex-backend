DJANGO_ENV=local
DJANGO_SECRET_KEY=replace-with-local-development-secret
DJANGO_DEBUG=True
DJANGO_LOAD_DOTENV=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=False
CSRF_TRUSTED_ORIGINS=
USE_X_FORWARDED_PROTO=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
DRF_NUM_PROXIES=1
THROTTLE_RATE_CONTACT=5/hour
THROTTLE_RATE_DEVIS_CREATE=10/hour
THROTTLE_RATE_DEVIS_GENERATE=10/hour
THROTTLE_RATE_CHATBOT=30/hour

# Required production variables:
# DJANGO_ENV=production
# DJANGO_DEBUG=False
# DJANGO_LOAD_DOTENV=False
# DJANGO_SECRET_KEY=<generate-a-long-random-secret>
# ALLOWED_HOSTS=api.smartdex.ma,<your-azure-container-app-hostname>
# CORS_ALLOWED_ORIGINS=https://smartdex.ma,https://www.smartdex.ma
# CSRF_TRUSTED_ORIGINS=https://smartdex.ma,https://www.smartdex.ma,https://api.smartdex.ma,https://<your-azure-container-app-hostname>
# DATABASE_URL=postgresql://user:password@host:5432/database
# OPENAI_API_KEY=replace-with-openai-api-key
#
# Optional production security overrides:
# USE_X_FORWARDED_PROTO=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
CHROMA_DIR=chroma_db
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_EXTERNAL_CALLS_ENABLED=True
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REQUEST_TIMEOUT_SECONDS=8
OPENAI_CONNECT_TIMEOUT_SECONDS=2
OPENAI_OPERATION_DEADLINE_SECONDS=17
OPENAI_MAX_RETRIES=1
OPENAI_RETRY_BASE_DELAY_SECONDS=0.25
OPENAI_RETRY_MAX_DELAY_SECONDS=1
OPENAI_CHAT_MAX_OUTPUT_TOKENS=220
OPENAI_REWRITE_MAX_OUTPUT_TOKENS=80
OPENAI_STRUCTURED_MAX_OUTPUT_TOKENS=800
OPENAI_EMBEDDING_BATCH_SIZE=64
OPENAI_MAX_INPUT_CHARACTERS=30000
OPENAI_RAG_CONTEXT_MAX_CHARACTERS=12000
OPENAI_RAG_MAX_TOP_K=12
# Must reflect the shortest reverse-proxy/Azure ingress deadline in production.
UPSTREAM_REQUEST_TIMEOUT_SECONDS=110

# Privacy/CNDP implementation review settings. Values are configurable after legal review.
SMARTDEX_PRIVACY_NOTICE_VERSION=2026-09-08
SMARTDEX_CONTACT_RETENTION_DAYS=365
SMARTDEX_ABANDONED_DEVIS_RETENTION_DAYS=365
SMARTDEX_COMPLETED_DEVIS_RETENTION_DAYS=2555
SMARTDEX_CHATBOT_RETENTION_DAYS=60
SMARTDEX_TEMP_PDF_RETENTION_HOURS=24

# Option 1: full database URL.
# Example PostgreSQL: postgresql://user:password@localhost:5432/smartdex
# Example SQLite: sqlite:///db.sqlite3
DATABASE_URL=

# Option 2: individual database settings, used when DATABASE_URL is empty.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Gunicorn/runtime settings used by gunicorn.conf.py.
PORT=8000
WEB_CONCURRENCY=2
GUNICORN_WORKER_CLASS=sync
GUNICORN_THREADS=1
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=500
GUNICORN_MAX_REQUESTS_JITTER=50
GUNICORN_PRELOAD=False
GUNICORN_LOG_LEVEL=info
