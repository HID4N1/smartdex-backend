# Local development defaults. Production values are documented in
# docs/production-configuration.md. Never store real secrets in this file.
DJANGO_ENV=local
DJANGO_DEBUG=True
DJANGO_LOAD_DOTENV=True
DJANGO_SECRET_KEY=replace-with-local-development-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=False
CSRF_TRUSTED_ORIGINS=

# HTTPS/cookies. Azure production may trust X-Forwarded-Proto only after its
# ingress sanitization and network boundary are verified.
USE_X_FORWARDED_PROTO=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# API limits and rates.
DRF_NUM_PROXIES=1
THROTTLE_RATE_CONTACT=5/hour
THROTTLE_RATE_DEVIS_CREATE=10/hour
THROTTLE_RATE_DEVIS_GENERATE=10/hour
THROTTLE_RATE_CHATBOT=30/hour

# Chroma. Docker overrides these with an immutable seed and /tmp runtime copy.
CHROMA_SEED_DIR=chroma_db
CHROMA_DIR=chroma_db
CHROMA_MANIFEST_PATH=chroma_index_manifest.json

# OpenAI reliability configuration.
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_EXTERNAL_CALLS_ENABLED=True
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REQUEST_TIMEOUT_SECONDS=8
OPENAI_CONNECT_TIMEOUT_SECONDS=2
OPENAI_OPERATION_DEADLINE_SECONDS=17
OPENAI_MAX_RETRIES=1
OPENAI_RETRY_BASE_DELAY_SECONDS=0.25
OPENAI_RETRY_MAX_DELAY_SECONDS=1
OPENAI_CHAT_MAX_OUTPUT_TOKENS=220
OPENAI_REWRITE_MAX_OUTPUT_TOKENS=80
OPENAI_STRUCTURED_MAX_OUTPUT_TOKENS=800
OPENAI_EMBEDDING_BATCH_SIZE=64
OPENAI_MAX_INPUT_CHARACTERS=30000
OPENAI_RAG_CONTEXT_MAX_CHARACTERS=12000
OPENAI_RAG_MAX_TOP_K=12
UPSTREAM_REQUEST_TIMEOUT_SECONDS=110

# Privacy/CNDP values remain configurable after legal review.
SMARTDEX_PRIVACY_NOTICE_VERSION=2026-09-08
SMARTDEX_CONTACT_RETENTION_DAYS=365
SMARTDEX_ABANDONED_DEVIS_RETENTION_DAYS=365
SMARTDEX_COMPLETED_DEVIS_RETENTION_DAYS=2555
SMARTDEX_CHATBOT_RETENTION_DAYS=60
SMARTDEX_TEMP_PDF_RETENTION_HOURS=24

# Database. DATABASE_URL is mandatory and PostgreSQL-only in production.
DATABASE_URL=
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_POOL_MODE=transaction
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=True
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000

# Gunicorn/runtime.
PORT=8000
WEB_CONCURRENCY=2
GUNICORN_WORKER_CLASS=sync
GUNICORN_THREADS=1
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=500
GUNICORN_MAX_REQUESTS_JITTER=50
GUNICORN_PRELOAD=False
GUNICORN_LOG_LEVEL=info
GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1
DJANGO_LOG_LEVEL=INFO
WHITENOISE_MAX_AGE=31536000

# Required Azure Container Apps production shape (examples only):
# DJANGO_ENV=production
# DJANGO_DEBUG=False
# DJANGO_LOAD_DOTENV=False
# DJANGO_SECRET_KEY=<inject-a-long-random-secret>
# ALLOWED_HOSTS=api.smartdex.ma,<app>.<region>.azurecontainerapps.io
# CORS_ALLOWED_ORIGINS=https://www.smartdex.ma
# CORS_ALLOW_CREDENTIALS=False
# CSRF_TRUSTED_ORIGINS=
# DATABASE_URL=postgresql://<user>:<password>@<pooler-host>:5432/<database>?sslmode=require
# OPENAI_API_KEY=<inject-from-an-Azure-secret>
# USE_X_FORWARDED_PROTO=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
# GUNICORN_FORWARDED_ALLOW_IPS=*
