DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_LOAD_DOTENV=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=False
CSRF_TRUSTED_ORIGINS=
USE_X_FORWARDED_PROTO=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# Required production variables:
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<generate-a-long-random-secret-in-railway>
# ALLOWED_HOSTS=api.smartdex.ma,<your-railway-domain>.up.railway.app
# CORS_ALLOWED_ORIGINS=https://smartdex.ma,https://www.smartdex.ma
# CSRF_TRUSTED_ORIGINS=https://api.smartdex.ma,https://<your-railway-domain>.up.railway.app
# DATABASE_URL=postgresql://user:password@host:5432/database
# OPENAI_API_KEY=your-openai-api-key
#
# Optional production security overrides:
# USE_X_FORWARDED_PROTO=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
CHROMA_DIR=chroma_db
OPENAI_API_KEY=your-openai-api-key

# Privacy/CNDP implementation review settings. Values are configurable after legal review.
SMARTDEX_PRIVACY_NOTICE_VERSION=2026-09-08
SMARTDEX_CONTACT_RETENTION_DAYS=365
SMARTDEX_ABANDONED_DEVIS_RETENTION_DAYS=365
SMARTDEX_COMPLETED_DEVIS_RETENTION_DAYS=2555
SMARTDEX_CHATBOT_RETENTION_DAYS=60
SMARTDEX_TEMP_PDF_RETENTION_HOURS=24

# Option 1: full database URL.
# Example PostgreSQL: postgresql://user:password@localhost:5432/smartdex
# Example SQLite: sqlite:///db.sqlite3
DATABASE_URL=

# Option 2: individual database settings, used when DATABASE_URL is empty.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
